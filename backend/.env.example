# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Database Connection (if using direct PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# API Configuration
PORT=8000
APP_NAME=AI Boss Decision Engine
API_VERSION=v1

# LLM — Gemini (Manager + document paths using services/llm_client.py)
GOOGLE_API_KEY=your_google_ai_studio_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
LLM_429_MAX_RETRIES=8
LLM_429_MAX_BACKOFF_SEC=60
LLM_BETWEEN_CALLS_SEC=0.15

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# Tavily (sales campaign suggestions API)
TAVILY_API_KEY=your_tavily_api_key_here

LLM_TEMPERATURE=0.7
SIMULATOR_MODEL=openai:gpt-4o-mini
NETWORK_SIM_MODEL=
NETWORK_WORLD_MODEL=
NETWORK_NODE_MODEL=
NETWORK_OBSERVER_MODEL=
PARSER_MODEL=
SELECTOR_MODEL=
PERSONA_MODEL=
BRANCH_MODEL=
RECOMMENDATION_MODEL=

# LangChain Configuration
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=your_langchain_api_key_here

GLM_API_KEY=your_glm_api_key_here
GLM_API_URL=https://api.glm.ai

# Marketing tools
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Zhipu / Ilmu (document SQL writer, HR/Legal/Finance JSON)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://api.ilmu.ai/v1
ZHIPU_MODEL=nemo-super

# Vector Store Configuration
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Cloudinary Configuration (for document uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
